# Copy to `.env` at the repo root (read automatically by `docker compose`) and
# fill in real values. Never commit the filled-in file.

# Postgres password for the `website` user. Only used by docker-compose.prod.yml
# (dev uses a fixed "website" password). Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# JWT signing key (>= 32 chars). The backend refuses to start without it.
# Generate with: openssl rand -hex 32
SECRET_KEY=
# Sign-up code asked by auth.alanbignon.com/signup (>= 16 chars).
# Generate with: openssl rand -hex 16
REGISTER_SECRET=

# Media: TMDB API Read Access Token (v4, "API Read Access Token" on
# themoviedb.org/settings/api). Dev and prod. Empty = film and series search
# unavailable; books (Open Library) need no key.
TMDB_READ_ACCESS_TOKEN=
